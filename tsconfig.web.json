{
	"compilerOptions": {
		"composite": true,
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@renderer/*": ["src/renderer/src/*"],
			"@shared/*": ["src/shared/*"]
		}
	},
	"include": ["src/renderer/src/**/*", "src/shared/**/*"]
}
