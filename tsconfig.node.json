{
	"compilerOptions": {
		"composite": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"lib": ["ESNext"],
		"types": ["electron-vite/node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "out"
	},
	"include": [
		"electron.vite.config.*",
		"src/main/**/*",
		"src/preload/**/*",
		"src/shared/**/*"
	]
}
